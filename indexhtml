<!DOCTYPE html>
<html lang="tr">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Senin İçin Kodladım 🌻</title>
<style>
    * { margin: 0; padding: 0; box-sizing: border-box; }
    body {
        background: #000;
        overflow: hidden;
        height: 100vh;
        font-family: Arial, sans-serif;
    }
    canvas {
        display: block;
        position: absolute;
        top: 0; left: 0;
    }
    .title, .second-text {
        position: absolute;
        width: 100%;
        text-align: center;
        color: #ffeb3b;
        font-weight: bold;
        text-shadow: 0 0 20px #ffeb3b, 0 0 40px #fbc02d;
        z-index: 10;
        opacity: 0;
        pointer-events: none;
    }
    .title {
        top: 8%;
        font-size: clamp(1.5rem, 5vw, 2.5rem);
        animation: fadeIn 1.5s ease-out 0.6s forwards;
    }
    .second-text {
        top: 16%;
        font-size: clamp(1.3rem, 4.5vw, 2.1rem);
        animation: fadeIn 1.5s ease-out 4s forwards;
    }
    @keyframes fadeIn {
        to { opacity: 1; }
    }
</style>
</head>
<body>
    <div class="title">Seni seviyorum</div>
    <div class="second-text">Yemeğini yedin mi?</div>
    <canvas id="c"></canvas>

<script>
const canvas = document.getElementById('c');
const ctx = canvas.getContext('2d');

function resize() {
    canvas.width = window.innerWidth;
    canvas.height = window.innerHeight;
    createBouquet();
}
window.addEventListener('resize', resize);

const stars = Array.from({length: 240}, () => ({
    x: Math.random(),
    y: Math.random(),
    r: Math.random() * 1.6 + 0.3,
    a: Math.random() * 0.9 + 0.15,
    speed: Math.random() * 0.018 + 0.004
}));

let flowers = [];

function createBouquet() {
    flowers = [];
    const cx = canvas.width / 2;
    const baseY = canvas.height * 0.84;

    const positions = [
        {x: 0,    y: 0,   size: 32, delay: 0.0},
        {x: -48,  y: 18,  size: 28, delay: 0.3},
        {x: 52,   y: 15,  size: 29, delay: 0.45},
        {x: -28,  y: -25, size: 26, delay: 0.6},
        {x: 30,   y: -22, size: 27, delay: 0.75},
        {x: -70,  y: 35,  size: 24, delay: 0.9},
        {x: 75,   y: 32,  size: 25, delay: 1.05},
        {x: 0,    y: 40,  size: 23, delay: 1.2}
    ];

    positions.forEach((p) => {
        flowers.push({
            x: cx + p.x,
            y: baseY + p.y,
            size: p.size,
            delay: p.delay,
            petalCount: 14,
            swayPhase: Math.random() * Math.PI * 2,
            swaySpeed: 1.0 + Math.random() * 0.5
        });
    });
}

resize();

let start = null;

function drawFlower(f, t) {
    const grow = Math.min(1, Math.max(0, (t - f.delay) / 1.6));
    if (grow <= 0) return;

    const sway = Math.sin(t * f.swaySpeed + f.swayPhase) * 7 * grow;

    const s = f.size * (0.1 + grow * 0.9);
    const stemH = 110 * grow;
    const headX = f.x + sway;
    const headY = f.y - stemH;

    // Sap
    ctx.beginPath();
    ctx.moveTo(f.x, f.y + 8);
    ctx.quadraticCurveTo(f.x + sway * 0.55, f.y - stemH * 0.48, headX, headY);
    ctx.strokeStyle = '#2e7d32';
    ctx.lineWidth = 6;
    ctx.lineCap = 'round';
    ctx.stroke();

    // Yapraklar
    if (grow > 0.2) {
        const lg = Math.min(1, (grow - 0.2) / 0.5);
        ctx.fillStyle = '#43a047';

        ctx.save();
        ctx.translate(f.x - 12 + sway * 0.25, f.y - stemH * 0.5);
        ctx.rotate(-0.8 + Math.sin(t * 1.2) * 0.1);
        ctx.beginPath();
        ctx.ellipse(0, 0, 26 * lg, 11 * lg, 0, 0, Math.PI * 2);
        ctx.fill();
        ctx.restore();

        ctx.save();
        ctx.translate(f.x + 14 + sway * 0.25, f.y - stemH * 0.35);
        ctx.rotate(0.7 + Math.sin(t * 1.0) * 0.1);
        ctx.beginPath();
        ctx.ellipse(0, 0, 22 * lg, 10 * lg, 0, 0, Math.PI * 2);
        ctx.fill();
        ctx.restore();
    }

    // Taç yapraklar
    for (let i = 0; i < f.petalCount; i++) {
        const ang = (i / f.petalCount) * Math.PI * 2;
        const px = headX + Math.cos(ang) * s * 0.88;
        const py = headY + Math.sin(ang) * s * 0.88;

        ctx.beginPath();
        ctx.ellipse(px, py, s * 0.45, s * 0.21, ang, 0, Math.PI * 2);
        ctx.fillStyle = '#ffeb3b';
        ctx.fill();
        ctx.strokeStyle = '#f9a825';
        ctx.lineWidth = 1.4;
        ctx.stroke();
    }

    // Merkez
    ctx.beginPath();
    ctx.arc(headX, headY, s * 0.36, 0, Math.PI * 2);
    ctx.fillStyle = '#3e2723';
    ctx.fill();

    ctx.beginPath();
    ctx.arc(headX, headY, s * 0.22, 0, Math.PI * 2);
    ctx.fillStyle = '#5d4037';
    ctx.fill();
}

function loop(timestamp) {
    if (!start) start = timestamp;
    const t = (timestamp - start) / 1000;

    ctx.fillStyle = '#000';
    ctx.fillRect(0, 0, canvas.width, canvas.height);

    // Yıldızlar
    stars.forEach(s => {
        s.a += (Math.random() - 0.5) * s.speed;
        s.a = Math.max(0.1, Math.min(1, s.a));
        ctx.beginPath();
        ctx.arc(s.x * canvas.width, s.y * canvas.height, s.r, 0, Math.PI * 2);
        ctx.fillStyle = `rgba(255,255,255,${s.a})`;
        ctx.fill();
    });

    // Çiçekler (artık hiç kaybolmuyor)
    flowers.forEach(f => drawFlower(f, t));

    requestAnimationFrame(loop);
}

requestAnimationFrame(loop);
</script>
</body>
</html>
